; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ruby Cocoon"
config/description="Train, merge and battle elemental beasts across twelve towns."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/stretch_mode=4
boot_splash/bg_color=Color(0.012, 0.016, 0.098, 1)
boot_splash/image="res://assets/icon/boot_splash.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Prefs="*res://scripts/autoload/prefs.gd"
UI="*res://scripts/autoload/ui.gd"
Menus="*res://scripts/autoload/menus.gd"
Places="*res://scripts/autoload/places.gd"
Story="*res://scripts/autoload/story.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
